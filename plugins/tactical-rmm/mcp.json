{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tactical-rmm": {
      "type": "streamable-http",
      "url": "https://tactical-mcp.tronderdata.no/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "tactical-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "baseScopes": [
              "tactical-rmm"
            ]
          }
        }
      }
    }
  }
}
